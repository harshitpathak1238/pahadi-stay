generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "mysql"
	url      = env("DATABASE_URL")
}

enum Role {
	CUSTOMER
	PARTNER
	ADMIN
	OWNER
	STAFF
}

enum ListingCategory {
	STAY
	RIDE
	RENTAL
	ACTIVITY
}

enum VerificationStatus {
	PENDING
	VERIFIED
	REJECTED
}

enum ListingStatus {
	DRAFT
	LIVE
	PAUSED
	PENDING_REVIEW
}

enum BlogStatus {
	DRAFT
	SCHEDULED
	PUBLISHED
	ARCHIVED
}

enum BookingStatus {
	PENDING
	CONFIRMED
	CANCELLED
	COMPLETED
}

enum PaymentStatus {
	CREATED
	AUTHORIZED
	CAPTURED
	FAILED
	REFUNDED
}

enum PickupStatus {
	UNASSIGNED
	ASSIGNED
	EN_ROUTE
	COMPLETED
	CANCELLED
}

model User {
	id                  String             @id @default(cuid())
	name                String?
	email               String?            @unique
	passwordHash        String?
	phone               String?            @unique
	role                Role               @default(CUSTOMER)
	createdAt           DateTime           @default(now())
	partner             Partner?
	bookings            Booking[]
	trips               Trip[]
	reviews             Review[]
	passwordResetTokens PasswordResetToken[]
	blogPosts           BlogPost[]
}

model PasswordResetToken {
	id        String   @id @default(cuid())
	tokenHash String   @unique
	userId    String
	expiresAt DateTime
	usedAt    DateTime?
	createdAt DateTime @default(now())
	user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@index([userId, expiresAt])
}

model Partner {
	id                 String             @id @default(cuid())
	userId             String             @unique
	businessName       String
	category           ListingCategory
	verificationStatus VerificationStatus @default(PENDING)
	payoutDetails      Json?
	user               User               @relation(fields: [userId], references: [id])
	listings           Listing[]
	vehicles           Vehicle[]
}

model Listing {
	id           String           @id @default(cuid())
	slug         String           @unique
	partnerId    String
	category     ListingCategory
	title        String
	description  String
	location     String
	basePrice    Decimal          @db.Decimal(10, 2)
	sellPrice    Decimal          @db.Decimal(10, 2)
	bikeQuantity Int              @default(0)
	scootyQuantity Int            @default(0)
	images       Json
	amenities    Json
	status       ListingStatus    @default(DRAFT)
	partner      Partner          @relation(fields: [partnerId], references: [id])
	availability Availability[]
	bookings     Booking[]
	reviews      Review[]
	createdAt    DateTime         @default(now())

	@@index([category, status])
}

model Availability {
	id            String   @id @default(cuid())
	listingId     String
	date          DateTime
	isAvailable   Boolean  @default(true)
	priceOverride Decimal? @db.Decimal(10, 2)
	listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

	@@unique([listingId, date])
	@@index([date])
}

model Booking {
	id               String        @id @default(cuid())
	tripId           String?
	userId           String?
	listingId        String
	category         ListingCategory @default(STAY)
	startDate        DateTime?
	endDate          DateTime?
	checkIn          DateTime
	checkOut         DateTime?
	guests           Int
	quantity         Int           @default(1)
	rentalType      String?
	status           BookingStatus @default(PENDING)
	priceAtBooking   Decimal       @default(0) @db.Decimal(10, 2)
	totalPrice       Decimal       @db.Decimal(10, 2)
	commissionAmount Decimal       @db.Decimal(10, 2)
	guestName        String
	guestEmail       String
	guestPhone       String
	metadata         Json?
	user             User?         @relation(fields: [userId], references: [id])
	trip             Trip?         @relation(fields: [tripId], references: [id], onDelete: Cascade)
	listing          Listing       @relation(fields: [listingId], references: [id])
	pickupRequest    PickupRequest?
	createdAt        DateTime      @default(now())

	@@index([status])
	@@index([listingId, checkIn, checkOut])
	@@index([tripId])
}

model Trip {
	id          String    @id @default(cuid())
	userId      String?
	reference   String    @unique
	status      BookingStatus @default(PENDING)
	expiresAt   DateTime?
	confirmedAt DateTime?
	reminderSentAt DateTime?
	createdAt   DateTime  @default(now())
	user        User?     @relation(fields: [userId], references: [id])
	bookings    Booking[]
	payments    Payment[]

	@@index([userId, status])
	@@index([expiresAt])
}

model Payment {
	id               String        @id @default(cuid())
	tripId           String
	razorpayOrderId  String?
	razorpayPaymentId String?
	status           PaymentStatus @default(CREATED)
	amount           Decimal       @db.Decimal(10, 2)
	refundedAmount   Decimal       @default(0) @db.Decimal(10, 2)
	trip             Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
	createdAt        DateTime      @default(now())

	@@index([tripId, status])
}

model Vehicle {
	id                 String  @id @default(cuid())
	partnerId          String
	type               String
	registrationNumber String
	driverName         String
	driverPhone        String
	isActive            Boolean @default(true)
	partner             Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
	pickupRequests      PickupRequest[]

	@@index([partnerId, isActive])
}

model PickupRequest {
	id                 String       @id @default(cuid())
	bookingId          String       @unique
	pickupLocationText String
	pickupLat          Decimal?     @db.Decimal(10, 7)
	pickupLng          Decimal?     @db.Decimal(10, 7)
	dropoffLocationText String
	requestedTime      DateTime
	assignedVehicleId  String?
	status             PickupStatus @default(UNASSIGNED)
	booking            Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
	assignedVehicle    Vehicle?     @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)

	@@index([status, requestedTime])
}

model Review {
	id        String   @id @default(cuid())
	listingId String
	userId    String
	rating    Int
	comment   String
	createdAt DateTime @default(now())
	listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
	user      User     @relation(fields: [userId], references: [id])

	@@index([listingId])
}

model Package {
	id         String   @id @default(cuid())
	title      String
	description String
	listingIds Json
	price      Decimal  @db.Decimal(10, 2)
	createdAt  DateTime @default(now())
}

model BlogPost {
	id              String     @id @default(cuid())
	slug            String     @unique
	title           String
	metaTitle       String
	metaDescription String     @db.Text
	excerpt         String     @db.Text
	body            String     @db.LongText
	authorName      String
	authorId        String?
	category        String
	primaryKeyword  String
	tags            Json
	featuredImage   String?
	imageUrls       Json       @default("[]")
	imageAltText    String?
	status          BlogStatus @default(DRAFT)
	scheduledAt     DateTime?
	publishedAt     DateTime?
	createdAt       DateTime   @default(now())
	updatedAt       DateTime   @updatedAt
	author          User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

	@@index([status, publishedAt])
	@@index([status, scheduledAt])
	@@index([category])
}

model MediaAsset {
	id          String   @id @default(cuid())
	filename    String
	url         String   @unique
	mimeType    String
	size        Int
	width       Int?
	height      Int?
	altText     String?
	thumbnailUrl String?
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	@@index([mimeType])
	@@index([createdAt])
}
