generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "mysql"
	url      = env("DATABASE_URL")
}

enum Role {
	CUSTOMER
	PARTNER
	ADMIN
	OWNER
	STAFF
}

enum ListingCategory {
	STAY
	RIDE
	RENTAL
	ACTIVITY
}

enum VerificationStatus {
	PENDING
	VERIFIED
	REJECTED
}

enum ListingStatus {
	DRAFT
	LIVE
	PAUSED
	PENDING_REVIEW
}

enum BlogStatus {
	DRAFT
	SCHEDULED
	PUBLISHED
	ARCHIVED
}

enum PackageStatus {
	DRAFT
	LIVE
	PAUSED
}

enum RideType {
	SIGHTSEEING
	TRANSFER
}

enum RideStatus {
	DRAFT
	LIVE
	PAUSED
}

enum BookingStatus {
	PENDING
	CONFIRMED
	CANCELLED
	COMPLETED
}

enum PaymentStatus {
	CREATED
	AUTHORIZED
	CAPTURED
	FAILED
	REFUNDED
}

enum PickupStatus {
	UNASSIGNED
	ASSIGNED
	EN_ROUTE
	COMPLETED
	CANCELLED
}

model User {
	id                  String             @id @default(cuid())
	name                String?
	email               String?            @unique
	passwordHash        String?
	phone               String?            @unique
	role                Role               @default(CUSTOMER)
	createdAt           DateTime           @default(now())
	partner             Partner?
	bookings            Booking[]
	trips               Trip[]
	reviews             Review[]
	passwordResetTokens PasswordResetToken[]
	blogPosts           BlogPost[]
}

model PasswordResetToken {
	id        String   @id @default(cuid())
	tokenHash String   @unique
	userId    String
	expiresAt DateTime
	usedAt    DateTime?
	createdAt DateTime @default(now())
	user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@index([userId, expiresAt])
}

model Partner {
	id                 String             @id @default(cuid())
	userId             String             @unique
	businessName       String
	category           ListingCategory
	verificationStatus VerificationStatus @default(PENDING)
	payoutDetails      Json?
	user               User               @relation(fields: [userId], references: [id])
	listings           Listing[]
	vehicles           Vehicle[]
}

model Listing {
	id           String           @id @default(cuid())
	slug         String           @unique
	partnerId    String
	category     ListingCategory
	title        String
	description  String           @db.LongText
	location     String
	basePrice    Decimal          @db.Decimal(10, 2)
	sellPrice    Decimal          @db.Decimal(10, 2)
	bikeQuantity Int              @default(0)
	scootyQuantity Int            @default(0)
	images       Json
	amenities    Json
	details      Json?
	mealPlan     String?
	breakfastIncluded Boolean @default(false)
	cuisineNotes String?          @db.Text
	houseRules   Json?           @default("[]")
	status       ListingStatus    @default(DRAFT)
	partner      Partner          @relation(fields: [partnerId], references: [id])
	availability Availability[]
	bookings     Booking[]
	reviews      Review[]
	faqs         ListingFaq[]
	landmarks    ListingLandmark[]
	services     ListingService[]
	experiences  ListingExperience[]
	createdAt    DateTime         @default(now())

	@@index([category, status])
}

model ListingFaq {
	id        String   @id @default(cuid())
	listingId String
	listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
	question  String
	answer    String   @db.Text
	order     Int      @default(0)
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@index([listingId])
}

model ListingLandmark {
	id         String   @id @default(cuid())
	listingId  String
	listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
	label      String
	distanceKm Float
	order      Int      @default(0)

	@@index([listingId])
}

model ListingService {
	id        String   @id @default(cuid())
	listingId String
	listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
	label     String
	note      String?
	order     Int      @default(0)

	@@index([listingId])
}

model ListingExperience {
	id        String   @id @default(cuid())
	listingId String
	listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
	title     String
	note      String?
	order     Int      @default(0)

	@@index([listingId])
}

model Availability {
	id            String   @id @default(cuid())
	listingId     String
	date          DateTime
	isAvailable   Boolean  @default(true)
	priceOverride Decimal? @db.Decimal(10, 2)
	listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

	@@unique([listingId, date])
	@@index([date])
}

model Booking {
	id               String        @id @default(cuid())
	tripId           String?
	userId           String?
	listingId        String
	category         ListingCategory @default(STAY)
	startDate        DateTime?
	endDate          DateTime?
	checkIn          DateTime
	checkOut         DateTime?
	guests           Int
	quantity         Int           @default(1)
	rentalType      String?
	status           BookingStatus @default(PENDING)
	priceAtBooking   Decimal       @default(0) @db.Decimal(10, 2)
	totalPrice       Decimal       @db.Decimal(10, 2)
	commissionAmount Decimal       @db.Decimal(10, 2)
	guestName        String
	guestEmail       String
	guestPhone       String
	metadata         Json?
	user             User?         @relation(fields: [userId], references: [id])
	trip             Trip?         @relation(fields: [tripId], references: [id], onDelete: Cascade)
	listing          Listing       @relation(fields: [listingId], references: [id])
	pickupRequest    PickupRequest?
	reviews          Review[]
	createdAt        DateTime      @default(now())

	@@index([status])
	@@index([listingId, checkIn, checkOut])
	@@index([tripId])
}

model Trip {
	id          String    @id @default(cuid())
	userId      String?
	reference   String    @unique
	status      BookingStatus @default(PENDING)
	expiresAt   DateTime?
	confirmedAt DateTime?
	reminderSentAt DateTime?
	createdAt   DateTime  @default(now())
	user        User?     @relation(fields: [userId], references: [id])
	bookings    Booking[]
	payments    Payment[]

	@@index([userId, status])
	@@index([expiresAt])
}

model Payment {
	id               String        @id @default(cuid())
	tripId           String
	razorpayOrderId  String?
	razorpayPaymentId String?
	status           PaymentStatus @default(CREATED)
	amount           Decimal       @db.Decimal(10, 2)
	refundedAmount   Decimal       @default(0) @db.Decimal(10, 2)
	trip             Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
	createdAt        DateTime      @default(now())

	@@index([tripId, status])
}

model Vehicle {
	id                 String  @id @default(cuid())
	partnerId          String
	type               String
	registrationNumber String
	driverName         String
	driverPhone        String
	isActive            Boolean @default(true)
	partner             Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
	pickupRequests      PickupRequest[]

	@@index([partnerId, isActive])
}

model PickupRequest {
	id                 String       @id @default(cuid())
	bookingId          String       @unique
	pickupLocationText String
	pickupLat          Decimal?     @db.Decimal(10, 7)
	pickupLng          Decimal?     @db.Decimal(10, 7)
	dropoffLocationText String
	requestedTime      DateTime
	assignedVehicleId  String?
	status             PickupStatus @default(UNASSIGNED)
	booking            Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
	assignedVehicle    Vehicle?     @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)

	@@index([status, requestedTime])
}

enum ReviewStatus {
	PENDING
	APPROVED
	REJECTED
}

model Review {
	id            String       @id @default(cuid())
	listingId     String
	userId        String?
	bookingId     String?
	guestName     String       @default("")
	guestEmail    String?
	rating        Int?
	overallRating Float        @default(5)
	staff         Float?
	facilities    Float?
	cleanliness   Float?
	comfort       Float?
	valueForMoney Float?
	location      Float?
	comment       String       @db.Text
	status        ReviewStatus @default(PENDING)
	isVerified    Boolean      @default(false)
	createdAt     DateTime     @default(now())
	updatedAt     DateTime     @updatedAt
	listing       Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
	user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
	booking       Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)

	@@index([listingId, status])
	@@index([status, createdAt])
}

model Package {
	id         String   @id @default(cuid())
	title      String
	description String  @db.LongText
	listingIds Json
	price      Decimal  @db.Decimal(10, 2)
	details    Json     @default("{}")
	status     PackageStatus @default(DRAFT)
	createdAt  DateTime @default(now())
}

model BlogPost {
	id              String     @id @default(cuid())
	slug            String     @unique
	title           String
	metaTitle       String
	metaDescription String     @db.Text
	excerpt         String     @db.Text
	body            String     @db.LongText
	authorName      String
	authorId        String?
	category        String
	primaryKeyword  String
	tags            Json
	featuredImage   String?
	imageUrls       Json       @default("[]")
	imageAltText    String?
	status          BlogStatus @default(DRAFT)
	scheduledAt     DateTime?
	publishedAt     DateTime?
	createdAt       DateTime   @default(now())
	updatedAt       DateTime   @updatedAt
	author          User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

	@@index([status, publishedAt])
	@@index([status, scheduledAt])
	@@index([category])
}

model MediaAsset {
	id          String   @id @default(cuid())
	filename    String
	url         String   @unique
	mimeType    String
	size        Int
	width       Int?
	height      Int?
	altText     String?
	thumbnailUrl String?
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	@@index([mimeType])
	@@index([createdAt])
}

// Rides & sightseeing: dedicated models so every route/package can carry its
// own fare-per-vehicle matrix instead of forcing one price into the generic
// Listing model (which only has a single base/sell price).
model VehicleType {
	id        String      @id @default(cuid())
	name      String
	capacity  Int         @default(4)
	image     String?
	order     Int         @default(0)
	fares     RideFare[]
	createdAt DateTime    @default(now())
	updatedAt DateTime    @updatedAt

	@@index([order])
}

model RideRoute {
	id              String      @id @default(cuid())
	slug            String      @unique
	title           String
	type            RideType    @default(SIGHTSEEING)
	description     String      @default("") @db.LongText
	fromLocation    String?
	toLocation      String?
	distanceKm      Float?
	durationDays    Int?
	images          Json        @default("[]")
	status          RideStatus  @default(DRAFT)
	order           Int         @default(0)
	createdAt       DateTime    @default(now())
	updatedAt       DateTime    @updatedAt
	stops           RideStop[]
	fares           RideFare[]

	@@index([status, type, order])
}

model RideStop {
	id          String    @id @default(cuid())
	rideRouteId String
	rideRoute   RideRoute @relation(fields: [rideRouteId], references: [id], onDelete: Cascade)
	label       String
	note        String?
	order       Int       @default(0)

	@@index([rideRouteId])
}

model RideFare {
	id            String      @id @default(cuid())
	rideRouteId   String
	rideRoute     RideRoute   @relation(fields: [rideRouteId], references: [id], onDelete: Cascade)
	vehicleTypeId String
	vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
	price         Float

	@@unique([rideRouteId, vehicleTypeId])
	@@index([vehicleTypeId])
}

